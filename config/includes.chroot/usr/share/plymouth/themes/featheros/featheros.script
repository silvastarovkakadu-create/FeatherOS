Window.SetBackgroundTopColor(0.025, 0.03, 0.055);
Window.SetBackgroundBottomColor(0.025, 0.03, 0.055);
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth()/2 - logo.image.GetWidth()/2);
logo.sprite.SetY(Window.GetHeight()/2 - logo.image.GetHeight()/2 - 28);
logo.sprite.SetOpacity(0);

track.image = Image("progress-track.png");
track.sprite = Sprite(track.image);
track.sprite.SetX(Window.GetWidth()/2 - track.image.GetWidth()/2);
track.sprite.SetY(Window.GetHeight()/2 + 92);

progress.original_image = Image("progress-fill.png");
progress.image = progress.original_image.Scale(1, progress.original_image.GetHeight());
progress.sprite = Sprite(progress.image);
progress.sprite.SetX(Window.GetWidth()/2 - progress.original_image.GetWidth()/2);
progress.sprite.SetY(Window.GetHeight()/2 + 92);

fun refresh_callback () {
  t = Plymouth.GetTime();
  fade = Math.Min(1, t / 0.7);
  logo.sprite.SetOpacity(fade);
}
Plymouth.SetRefreshFunction(refresh_callback);

fun boot_progress_callback (duration, percent_done) {
  width = Math.Int(progress.original_image.GetWidth() * percent_done);
  if (width < 1) width = 1;
  if (progress.image.GetWidth() != width) {
    progress.image = progress.original_image.Scale(width, progress.original_image.GetHeight());
    progress.sprite.SetImage(progress.image);
  }
}
Plymouth.SetBootProgressFunction(boot_progress_callback);

fun message_callback (text) { }
Plymouth.SetMessageFunction(message_callback);
