#!/bin/sh
set -eu

if [ -d binary/isolinux ]; then
    cp -f config/bootloaders/isolinux/isolinux.cfg binary/isolinux/isolinux.cfg
    cp -f config/bootloaders/isolinux/menu.cfg binary/isolinux/menu.cfg
    cp -f config/bootloaders/isolinux/stdmenu.cfg binary/isolinux/stdmenu.cfg
    cp -f config/bootloaders/isolinux/live.cfg binary/isolinux/live.cfg
    cp -f config/bootloaders/isolinux/splash.png binary/isolinux/splash.png
fi

if [ -d binary/boot/grub ]; then
    cp -f config/bootloaders/grub/splash.png binary/boot/grub/splash.png
fi

find binary -type f \( -name '*.cfg' -o -name '*.conf' -o -name '*.txt' \) -exec sed -i \
    -e 's/Debian GNU\/Linux/FeatherOS/g' \
    -e 's/Debian Live/FeatherOS/g' \
    -e 's/Debian/FeatherOS/g' \
    -e 's/Live system (amd64 fail-safe mode)/FeatherOS (safe graphics)/g' \
    -e 's/Live system (amd64)/Try or Install FeatherOS/g' \
    -e 's/Utilities\.\.\./Advanced options/g' \
    {} + 2>/dev/null || true
